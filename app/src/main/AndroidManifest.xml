<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Permiso de nivel normal: se concede al instalar, sin diálogo ni solicitud en
        tiempo de ejecución. Necesario para la confirmación táctil del material revisado
        y el aviso al terminar el audio de apoyo (ver device/Vibrador.kt).

        RNF-03: la aplicación NO declara CAMERA, RECORD_AUDIO, ACCESS_FINE_LOCATION,
        ACCESS_COARSE_LOCATION ni USE_BIOMETRIC.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MpazPro3">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MpazPro3">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>