# Datos de firma del APK release. NO subas este archivo con datos reales.
#
# 1. Copia este archivo como "keystore.properties" (en esta misma carpeta, junto a gradlew).
#    El nombre keystore.properties ya está en .gitignore: Git no lo sube.
# 2. Completa tus datos. Usa "/" en las rutas, también en Windows (por ejemplo C:/Users/tu_usuario/llaves/mi-llave.jks).
# 3. Genera el APK con:  ./gradlew assembleRelease   (en Windows: gradlew.bat assembleRelease)
#
# Si falta cualquiera de los cuatro datos, el build release se genera igual pero SIN firmar.
# Alternativa: definir estos mismos nombres en ~/.gradle/gradle.properties o como variables de entorno.

MPAZPRO_STORE_FILE=C:/ruta/a/mi-llave.jks
MPAZPRO_STORE_PASSWORD=clave-del-almacen
MPAZPRO_KEY_ALIAS=mi-alias
MPAZPRO_KEY_PASSWORD=clave-de-la-llave
